# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://trendrec:trendrec_dev@localhost:5432/trendrec

# OpenAI для генерации идей
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# YandexGPT (альтернатива OpenAI, бесплатно)
YANDEXGPT_API_KEY=
YANDEX_FOLDER_ID=

# Какой AI использовать: "openai", "yandexgpt", или "" (только статика)
AI_PROVIDER=

# Настройки дайджеста
DAILY_DIGEST_TIME=10:00
ADMIN_IDS=123456789,987654321
